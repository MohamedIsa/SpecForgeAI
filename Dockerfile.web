# syntax=docker/dockerfile:1
#
# Multi-stage build for the React 19 SPA  .
#
# Unlike the backend, this build genuinely needs apps/backend present too:
# apps/web/src/lib/brd-upload-client.ts imports MAX_BRD_FILE_BYTES from
# "@specforge/backend/brd-constants" at runtime (not just for types) — that
# module is deliberately kept free of Node built-ins specifically so it can
# be bundled straight into the browser, and Vite resolves the workspace
# `exports` mapping straight to that source file. apps/backend does NOT need
# to be built first; only its source and package.json/exports are needed for
# module resolution.

FROM node:22-alpine AS base
RUN corepack enable
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages/config-typescript packages/config-typescript
COPY packages/design-tokens packages/design-tokens
COPY apps/backend apps/backend
COPY apps/web apps/web

# ---------------------------------------------------------------------------
# Stage: builder
# ---------------------------------------------------------------------------
FROM base AS builder
RUN pnpm install --frozen-lockfile
RUN pnpm --filter @specforge/web run build

# ---------------------------------------------------------------------------
# Stage: runner
# ---------------------------------------------------------------------------
FROM nginx:alpine AS runner

COPY apps/web/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/apps/web/dist /usr/share/nginx/html

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -qO- http://127.0.0.1/healthz | grep -q '^ok' || exit 1

CMD ["nginx", "-g", "daemon off;"]
